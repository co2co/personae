# Python
__pycache__/
*.py[cod]
venv/
env/

# Temp / working backups
*.bak
*.bak-*
_bak_*/
_wb_*
backups/

# Packaged backups
*.zip

# Runtime data (ephemeral session state)
engine/data/sessions/
engine/data/state.json

# 引擎运行展示截图（随分发包 zip 提供，供用户预览界面；不进版本库）
# package.py 走文件系统 os.walk 打包，与 git 无关，故此处 ignore 只影响 git，不影响分发
engine/screenshots/
# 人眼核验不合格、已隔离出分发包的截图（拍到私人剧本角色名/题材词）：留磁盘不入库不进包
engine/screenshots-excluded/

# 用户私人剧本数据（官方 demo 在 data/examples/，其余 characters/worlds 为私人数据，不入库）
engine/data/characters/
engine/data/worlds/

# Test run artifacts（走查生成的 markdown 日志，非源码）
tests/runs/

# pytest cache
.pytest_cache/

# Editor / OS
.vscode/
.idea/
Thumbs.db
.DS_Store

# Project red-line exclusions（绝不纳入版本库）
.workbuddy/
nul

# Engine runtime logs（可能含会话/调试内容，不入库）
*.log

# 审计文件（含历史剧本信息，仅留工作树，不入库）
audit*.md

# 临时对比/压测脚本（含旧剧本角色名，仅作开发工具，不入库）
scripts/
