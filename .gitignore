# Python
__pycache__/
*.py[cod]
venv/
env/

# Temp / working backups
*.bak
*.bak-*
_bak_*/
_wb_*
backup/
_backup_*/
_sync_backup_*/
_backup_*.*

# 发版产物（交付物层，归档用，不进版本库）
dist/
audit/
*.zip

# Runtime data (ephemeral session state)
engine/data/sessions/
engine/data/state.json

# pytest 临时根目录（会话垃圾）
.tmp-pytest-*/

# 运行展示截图（2026-10-09 simon 裁定：不再随分发包提供，整体挪到项目根，仅留工作树）
# package.py 只 os.walk(engine/)，根目录天然不进包；此处 ignore 防止误提交
screenshots/
# 人眼核验不合格、含私人剧本角色名/题材词的截图：留磁盘不入库不进包
screenshots-excluded/

# 剧本 demo：data/examples/ 承载全部剧本（由 dramas/ 作者源经 sync_drama 铺入，入库且随包分发，2026-10-20 simon 裁定所有剧本均入库）；
# 其余 characters/worlds 为运行态（临时会话状态），不入库
engine/data/characters/
engine/data/worlds/

# Test run artifacts（走查生成的 markdown 日志，非源码）
tests/runs/

# 探针脚手架与一次性工具（A/B 对照、出厂条目同步等，仅开发用，不入库；
# 这类脚本常含私人剧本角色名，随删随弃。已跟踪文件不受 ignore 影响，
# 例如 tests/_frontend_binding_check.js 仍是入库的。）
tests/_probe*
tests/_diag*
tests/_measure*
tests/_verify_*
tests/_resync*

# 会话产物（摘录、导出等运行时态输出）
outputs/

# pytest cache
.pytest_cache/

# Editor / OS
.vscode/
.idea/
Thumbs.db
.DS_Store

# Project red-line exclusions（绝不纳入版本库）
.workbuddy/
nul

# Engine runtime logs（可能含会话/调试内容，不入库）
*.log

# 审计文件（含历史剧本信息，仅留工作树，不入库）
audit*.md

# 临时对比/压测脚本（含旧剧本角色名，仅作开发工具，不入库）
scripts/

# 剧本库（作者态：每剧本一个子目录 + 退役剧本备份；源不入库，内容经 sync_drama 同步至 data/examples/ 随包分发）
dramas/
